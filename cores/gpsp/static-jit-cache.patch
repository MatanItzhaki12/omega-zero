--- a/memmap.c
+++ b/memmap.c
@@ -3,6 +3,7 @@
 #include <stdbool.h>
 
 #include "memmap.h"
+#include "gpsp_config.h"
 
 // The JIT cache buffer is allocated via mmap (or win equivalent) so that it
 // can be RWX. On top of that, we need the bufer to be "close" to the text
@@ -100,6 +101,29 @@ bool validate_addr_section_mips(void *ptr, unsigned size, unsigned max_offset_mb
 
 	#include <sys/mman.h>
 
+#if defined(ARM64_ARCH)
+	// arm64: the cache is the library's own, a block of its .bss made executable, so it
+	// always lies within the +/-128MB a branch reaches. Mapped next to the text instead, a
+	// busy process may have no free block that close, and the failed map left the caches
+	// NULL for the first translated block to be written through.
+	static uint8_t jit_block[ROM_TRANSLATION_CACHE_SIZE + RAM_TRANSLATION_CACHE_SIZE]
+		__attribute__((aligned(4096)));
+
+	void *map_jit_block(unsigned size) {
+		uintptr_t pages = ((uintptr_t)size + 4095) & ~(uintptr_t)4095;
+		if (pages > sizeof(jit_block))
+			return 0;
+		if (mprotect(jit_block, pages, PROT_READ|PROT_WRITE|PROT_EXEC))
+			return 0;
+		return jit_block;
+	}
+
+	void unmap_jit_block(void *bufptr, unsigned size) {
+		// the block is the library's: it is flushed on the next init, never unmapped
+		(void)bufptr;
+		(void)size;
+	}
+#else
 	// Posix implementation
 	void *map_jit_block(unsigned size) {
 		unsigned i;
@@ -125,6 +149,7 @@ bool validate_addr_section_mips(void *ptr, unsigned size, unsigned max_offset_mb
 	void unmap_jit_block(void *bufptr, unsigned size) {
 		munmap(bufptr, size);
 	}
+#endif /* ARM64_ARCH */
 
 #endif /* WIN32 */
 
